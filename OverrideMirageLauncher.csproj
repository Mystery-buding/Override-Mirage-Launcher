<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OverrideMirageLauncher</AssemblyName>
    <RootNamespace>OverrideMirageLauncher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Override Mirage Launcher</Product>
    <AssemblyTitle>Override Mirage Launcher</AssemblyTitle>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="app.ico" />
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Blocks\Grass.png" />
    <Resource Include="Assets\Blocks\CommandBlock.png" />
    <Resource Include="Assets\Blocks\CobbleStone.png" />
    <Resource Include="Assets\Blocks\Fabric.png" />
    <Resource Include="Assets\Blocks\NeoForge.png" />
    <Resource Include="Assets\Blocks\Anvil.png" />
  </ItemGroup>

</Project>
